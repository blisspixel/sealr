[package]
name = "sealr-pypa-installer-handoff"
version = "0.0.0"
edition = "2021"
rust-version = "1.98"
license = "Apache-2.0"
publish = false

[workspace]

[dependencies]
sealr = "=0.1.0-alpha.15"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
sha2 = "0.11"

[target.'cfg(unix)'.dependencies]
libc = "=0.2.175"

[[bin]]
name = "sealr-pypa-installer-handoff"
path = "main.rs"
