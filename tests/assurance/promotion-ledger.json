      "id": "fuzz.protocol-semantic-and-tar.v2",
      "category": "coverage-guided-fuzzing",
      "scheduled_workflow": ".github/workflows/fuzz.yml",
      "scheduled_job": "Bounded worker protocol, semantic-record, and raw portable ustar fuzzing",
      "domain": "Digest-pinned protocol, semantic-record, and raw portable ustar seeds plus arbitrary bytes and input-directed checksum-repaired TAR mutations under the workflow's exact bounds.",
      "nonclaim": "Coverage-guided fuzzing is heuristic exploration, not exhaustive reachability or proof that the protocol, semantic-record, or TAR interpreters are defect-free.",
      "local_reproduction": [
        "pwsh -NoLogo -NoProfile -File scripts/verify_fuzz_seeds.ps1",
        "cargo fuzz run protocol_decoders -- -max_total_time=600 -rss_limit_mb=1024 -max_len=65536",
        "cargo fuzz run semantic_records -- -max_total_time=600 -rss_limit_mb=1024 -max_len=65536",
        "cargo fuzz run tar_ustar_portable_v1 -- -max_total_time=600 -rss_limit_mb=1024 -max_len=65536"
